# traceway-bridge/.env.example
#
# Copy to .env and fill in real values. NEVER commit .env — it is
# gitignored.
#
# To find each value:
#   - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY : a dev IAM key with
#       cloudwatch:GetMetricData, logs:DescribeLogGroups, logs:FilterLogEvents
#       and ec2:DescribeInstances (or just use whatever keys are already in
#       your local backend/config.ini [AWS]).
#   - AWS_REGION : the region the EC2 instance lives in (matches [DEFAULT]
#       env / [AWS] aws_region in backend/config.ini, usually eu-west-3).
#   - EC2_INSTANCE_ID : i-xxxxxxxxxxxxxxxxx — either pinned in
#       backend/config.ini [INFRASTRUCTURE] instance_id or looked up via
#       `aws ec2 describe-instances --region <r> --filters Name=instance-state-name,Values=running`.
#   - TITAN_ENV : "dev" on a laptop, "prod" on the EC2 host.
#   - OTLP_TOKEN : the traceway project bearer token. After booting
#       traceway, open http://localhost:80 and create a project; the token
#       appears under /connection (OpenTelemetry → token).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
EC2_INSTANCE_ID=
TITAN_ENV=dev
OTLP_TOKEN=

# Optional overrides. Uncomment to route logs/metrics to different traceway
# projects, e.g. when you want CloudWatch logs in their own project.
# TRACEWAY_OTLP_ENDPOINT_LOGS=http://traceway:80/api/otel/v1/logs
# TRACEWAY_OTLP_ENDPOINT_LOGS_BASE=http://traceway:80/api/otel
# TRACEWAY_OTLP_ENDPOINT_METRICS=http://traceway:80/api/otel/v1/metrics
# TRACEWAY_OTLP_ENDPOINT_TRACES=http://traceway:80/api/otel/v1/traces

# CW metrics poll cadence. Default 60 s; the legacy titan-monitor on-demand
# scrape was effectively the same cadence in `watch` mode.
# CW_POLL_INTERVAL_S=60

# DEBUG-level logging on either sidecar.
# LOG_LEVEL=INFO

# If you're on macOS/Windows with Docker Desktop and traceway is running
# OUTSIDE docker, override both endpoints to use host.docker.internal:
# TRACEWAY_OTLP_ENDPOINT_LOGS=http://host.docker.internal:80/api/otel/v1/logs
# TRACEWAY_OTLP_ENDPOINT_METRICS=http://host.docker.internal:80/api/otel/v1/metrics